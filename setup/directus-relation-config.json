  "setup_instructions": {
    "step1": "Create the kft_koha_enriched collection first using the SQL DDL or JSON definition",
    "step2": "Apply this relation configuration via Directus API or manually in the Admin UI",
    "step3": "Test the relation by querying: /items/kft_koha_biblios/{id}?fields=*,enriched.*",
    "note": "The O2M (One-to-Many) relation allows each biblio to have one enriched record. The M2O (Many-to-One) reverse relation allows enriched records to reference their parent biblio."
  },
  "example_api_calls": {
    "get_biblio_with_enriched": {
      "method": "GET",
      "url": "/items/kft_koha_biblios/71069?fields=*,enriched.*",
      "description": "Fetch a biblio with its enriched metadata"
    },
    "get_enriched_with_biblio": {
      "method": "GET",
      "url": "/items/kft_koha_enriched?filter[biblio_id][_eq]=71069&fields=*,biblio.*",
      "description": "Fetch enriched data with parent biblio details"
    },
    "search_enriched_join_biblio": {
      "method": "GET",
      "url": "/items/kft_koha_enriched?search=demokrati&fields=*,biblio.title,biblio.author",
