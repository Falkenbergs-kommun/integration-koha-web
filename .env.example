# API-konfiguration för Koha-integration
API_BASE_URL=https://example.com/api/v1/biblios/
OAUTH_URL=https://example.com/oauth/token
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# Base URL för cachade bilder (med avslutande /)
BASE_URL=https://bibliotek.falkenberg.se/fbg_apps/services/koha/

# Syndetics-konfiguration för bokomslag
SYNDETICS_CLIENT=bibfalken

# Cache-inställningar (i sekunder)
CACHE_TTL_LATEST=3600

# Directus Configuration (för Koha biblios sync)
DIRECTUS_API_URL=https://your-directus-url.com
DIRECTUS_API_TOKEN=your-directus-api-token-here

# Google Gemini AI Configuration (för AI-enrichment av bibliografisk metadata)
# Hämta API-nyckel från: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
